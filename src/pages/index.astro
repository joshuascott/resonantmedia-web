---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { quotes, services, site, steps } from "../data/site";

const title = "Resonant Media Technologies — Applied AI and agentic systems";
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: "+1-720-507-6888",
  image: new URL("/og.png", site.url).href,
  founder: {
    "@type": "Person",
    name: "Joshua Scott",
    sameAs: site.linkedin,
  },
  areaServed: "United States",
  description: site.description,
};
---

<Base title={title} description={site.description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <Header />
  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="kicker"><span class="bar" aria-hidden="true"></span>Loveland, Colorado</p>
          <h1>Applied AI,<br />built to do<br /><span>the work.</span></h1>
          <p class="lede">
            Resonant Media designs agentic systems and the software around them.
            Models, tools, and product engineering for teams that need a job done.
          </p>
          <div class="actions">
            <a class="btn" href="#contact">Start a project</a>
            <a class="btn btn-ghost" href="#services">What we build</a>
          </div>
        </div>
        <div class="hero-mark" role="img" aria-label="Resonant Media mark">
          <span class="mark-echo" aria-hidden="true"></span>
          <span class="mark-echo mark-echo-late" aria-hidden="true"></span>
          <img class="mark-ring" src="/brand/mark-ring.png" alt="" width="512" height="512" />
          <img class="mark-core" src="/brand/mark-core.png" alt="" width="512" height="512" />
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="wrap">
        <div class="section-intro">
          <div>
            <p class="kicker"><span class="bar" aria-hidden="true"></span>Services</p>
            <h2>What we build</h2>
          </div>
          <p class="intro-copy">
            Five kinds of work. A project usually draws on two or three of them, aimed at one job.
          </p>
        </div>
        <div class="service-list">
          {
            services.map((service) => (
              <article class="service">
                <h3>{service.title}</h3>
                <p>{service.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper" id="consulting">
      <div class="wrap partner-grid">
        <div>
          <p class="kicker"><span class="bar" aria-hidden="true"></span>AI consulting</p>
          <h2>Idea Collaborative</h2>
        </div>
        <div class="stack">
          <p>
            Idea Collaborative helps businesses put AI to work through workshops and
            hands-on consulting. A team leaves able to use the tools, with a short list
            of workflows and a plan they own.
          </p>
          <p>
            When that job is ready for software — an agent, a workflow, a product —
            Resonant Media builds it.
          </p>
          <div class="actions">
            <a class="btn" href={site.consultingUrl} target="_blank" rel="noopener noreferrer">
              Visit Idea Collaborative
              <span class="sr-only">(opens in a new tab)</span>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M4 12 12 4M7 4h5v5" fill="none" stroke="currentColor" stroke-width="1.6"></path>
              </svg>
            </a>
          </div>
          <p class="domain">
            <a href={site.consultingUrl}>ideacollaborative.com</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="approach">
      <div class="wrap">
        <div class="section-intro">
          <div>
            <p class="kicker"><span class="bar" aria-hidden="true"></span>Approach</p>
            <h2>How a build goes</h2>
          </div>
          <p class="intro-copy">
            The sequence is short on purpose. The job stays visible the whole way through.
          </p>
        </div>
        <ol class="steps">
          {
            steps.map((step) => (
              <li>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" id="studio">
      <div class="wrap studio-grid">
        <div>
          <p class="kicker"><span class="bar" aria-hidden="true"></span>Studio</p>
          <h2>Joshua Scott</h2>
          <p class="role">Founder</p>
        </div>
        <div class="stack">
          <p>
            Joshua leads Resonant Media Technologies from Loveland, Colorado. His practice
            is technology leadership, solution architecture, and shipping software. The
            studio puts that practice to work on applied AI and agentic systems.
          </p>
          <p class="since">Building software since 2001.</p>
          <a class="text-link" href={site.linkedin}>LinkedIn</a>
        </div>
      </div>
    </section>

    <section class="section" id="clients" aria-labelledby="clients-title">
      <div class="wrap">
        <p class="kicker"><span class="bar" aria-hidden="true"></span>Collaborators</p>
        <h2 id="clients-title">In their words</h2>
        <div class="quote-list">
          {
            quotes.map((quote) => (
              <blockquote class="quote">
                <p>{quote.text}</p>
                <footer>
                  <cite>{quote.name}</cite>
                  <span>{quote.role}</span>
                </footer>
              </blockquote>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section paper" id="contact">
      <div class="wrap contact-grid">
        <div>
          <p class="kicker"><span class="bar" aria-hidden="true"></span>Contact</p>
          <h2>Tell us the job.</h2>
          <div class="stack">
            <p>
              A few sentences are enough. If you want AI consulting or a workshop for the
              team, start with
              <a href={site.consultingUrl}>Idea Collaborative</a>.
            </p>
          </div>
          <div class="details">
            <p>
              <span>Email</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
            <p>
              <span>Phone</span>
              <a href={site.phoneHref}>{site.phoneDisplay}</a>
            </p>
          </div>
        </div>
        <form class="form" id="contact-form">
          <label class="field">
            <span>Name</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="field">
            <span>Organization</span>
            <input name="organization" type="text" autocomplete="organization" />
          </label>
          <label class="field">
            <span>The job</span>
            <textarea name="message" required></textarea>
          </label>
          <button class="btn" type="submit">Send a message</button>
          <p class="form-note" id="form-note" role="status"></p>
        </form>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  const form = document.querySelector("#contact-form");
  const note = document.querySelector("#form-note");

  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const organization = String(data.get("organization") || "").trim();
      const message = String(data.get("message") || "").trim();
      const lines = [
        `Name: ${name}`,
        `Email: ${email}`,
        organization ? `Organization: ${organization}` : null,
        "",
        message,
      ].filter((line) => line !== null);

      window.location.href = `mailto:hello@resonantmedia.com?subject=${encodeURIComponent(`Project inquiry from ${name}`)}&body=${encodeURIComponent(lines.join("\n"))}`;

      if (note) {
        note.textContent =
          "Your email app should open with this message. If it does not, write us at hello@resonantmedia.com.";
      }
    });
  }
</script>
